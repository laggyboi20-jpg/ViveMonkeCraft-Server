{
  "schemaVersion": 1,
  "id": "vivemonkecraft_server",
  "version": "${version}",
  "name": "ViveMonke(Quest)Craft — Server Config",
  "description": "Server-side companion for ViveMonke(Quest)Craft. Lets server admins cap movement settings and control whether the mod is allowed.",
  "authors": [
    "Laggyboi"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "laggyboi.vivemonkecraftserver.VivemonkecraftServerMod"
    ]
  },
  "mixins": [
    "vivemonkecraft-server.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
